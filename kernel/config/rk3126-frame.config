# Kernel configuration for the Denver Frameo picture frame (RK3126B),
# merged on top of multi_v7_defconfig. build-kernel.sh checks that every
# option listed here ends up in the final .config.
#
# Everything needed to boot from the SD card is built in (no initramfs).
# Modules are enabled for the "=m" drivers of multi_v7_defconfig and for
# out-of-tree drivers (RK915 WiFi).

CONFIG_LOCALVERSION=""
CONFIG_LOCALVERSION_AUTO=n
CONFIG_MODULES=y

CONFIG_BLK_DEV_INITRD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# SoC
CONFIG_ARCH_ROCKCHIP=y
CONFIG_PINCTRL_ROCKCHIP=y
CONFIG_COMMON_CLK_ROCKCHIP=y
CONFIG_CLK_RK312X=y

# Serial console (UART2)
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_DW=y
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_SERIAL_EARLYCON=y

# eMMC, SD card, SDIO
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_BLOCK_MINORS=32
CONFIG_MMC_DW=y
CONFIG_MMC_DW_PLTFM=y
CONFIG_MMC_DW_ROCKCHIP=y
CONFIG_PWRSEQ_SIMPLE=y

# USB: host ports and the OTG port as gadget (serial console + Ethernet)
CONFIG_PHY_ROCKCHIP_INNO_USB2=y
CONFIG_USB=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_HCD_PLATFORM=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_OHCI_HCD_PLATFORM=y
CONFIG_USB_STORAGE=y
CONFIG_USB_DWC2=y
CONFIG_USB_DWC2_DUAL_ROLE=y
CONFIG_USB_GADGET=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_CONFIGFS=y
# The legacy Ethernet gadget binds during kernel init. Without it the frame
# did not enumerate on the host at all when the configfs gadget was bound
# later; the usb-gadget script unbinds it before binding the configfs gadget.
CONFIG_USB_ETH=y
CONFIG_USB_CONFIGFS_SERIAL=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_MASS_STORAGE=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_RNDIS=y

# Display: VOP -> DW MIPI DSI -> Inno DSI D-PHY -> JD9365 panel
CONFIG_DRM=y
CONFIG_DRM_ROCKCHIP=y
CONFIG_ROCKCHIP_VOP=y
CONFIG_ROCKCHIP_DW_MIPI_DSI=y
CONFIG_PHY_ROCKCHIP_INNO_DSIDPHY=y
CONFIG_DRM_PANEL_JADARD_JD9365DA_H3=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_ROTATION=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_PWM=y
CONFIG_PWM_ROCKCHIP=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_REGULATOR_PWM=y

# GPU: Mali-400 MP2
CONFIG_DRM_LIMA=m
CONFIG_PM_DEVFREQ=y
CONFIG_DEVFREQ_GOV_SIMPLE_ONDEMAND=y

# Touchscreen and buttons. silead is a module: it loads its firmware at
# probe time, which needs the root filesystem.
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_SILEAD=m
CONFIG_INPUT_EVDEV=y
CONFIG_KEYBOARD_ADC=y
CONFIG_KEYBOARD_GPIO=y
CONFIG_ROCKCHIP_SARADC=y
CONFIG_I2C_RK3X=y
CONFIG_I2C_CHARDEV=y
CONFIG_POWER_RESET_GPIO=y

# WiFi (RK915, out-of-tree driver)
CONFIG_WLAN=y
CONFIG_WIRELESS=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y

# CPU frequency scaling: vdd_arm and the OPP table are in the device tree
CONFIG_CPU_FREQ=y
CONFIG_CPUFREQ_DT=y
CONFIG_CPU_FREQ_STAT=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
CONFIG_CPU_FREQ_GOV_USERSPACE=y
CONFIG_CPU_FREQ_GOV_ONDEMAND=y
CONFIG_CPU_IDLE=n

# File systems
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_VFAT_FS=y
CONFIG_FAT_DEFAULT_IOCHARSET="utf8"
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
CONFIG_EXFAT_FS=y
CONFIG_SQUASHFS=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_CMDLINE_PARTITION=y
CONFIG_CONFIGFS_FS=y

# Debian userland: systemd uses BPF for cgroup device/IP policies
CONFIG_BPF_SYSCALL=y
CONFIG_CGROUP_BPF=y

# Debugging
CONFIG_DEBUG_FS=y
CONFIG_DEVMEM=y
CONFIG_MAGIC_SYSRQ=y

# Not needed, saves kernel size
CONFIG_SOUND=n
CONFIG_MEDIA_SUPPORT=n
CONFIG_BT=n
CONFIG_STAGING=n
