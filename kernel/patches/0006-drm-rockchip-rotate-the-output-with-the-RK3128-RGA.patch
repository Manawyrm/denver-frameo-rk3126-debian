+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * RGA (version 1) of the RK3126/RK3128: rotation of 32 bpp images by 90 or
+ * 270 degrees, for the VOP driver.
+ *
+ * The RGA fetches its register settings from a command buffer in memory.
+ * The command values for a rotating bitblt are calculated the way the
+ * Rockchip vendor driver does it (drivers/video/rockchip/rga, rga_reg_info.c
+ * and RGA_API.c): the destination is processed in 8x8 tiles, and a 2x2
+ * matrix maps every destination tile back into the source.
+ *
+ * Source and destination go through the MMU of the RGA, a flat table of
+ * 4 KiB page addresses.
+ */
+
+#include <linux/clk.h>
+#include <linux/completion.h>
+#include <linux/debugfs.h>
+#include <linux/delay.h>
+#include <linux/dma-mapping.h>
+#include <linux/interrupt.h>
+#include <linux/io.h>
+#include <linux/ktime.h>
+#include <linux/math64.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/of_platform.h>
+#include <linux/platform_device.h>
+#include <linux/pm_runtime.h>
+
+#include "rockchip_drm_drv.h"
+#include "rockchip_rga1.h"
+
+#define RGA_SYS_CTRL			0x000
+#define RGA_SYS_CTRL_SOFT_RESET		BIT(0)
+#define RGA_SYS_CTRL_CMD_MODE		BIT(2)
+#define RGA_SYS_CTRL_MASTER_MODE	BIT(3)
+#define RGA_CMD_CTRL			0x004
+#define RGA_CMD_CTRL_START		BIT(0)
+#define RGA_CMD_ADDR			0x008
+#define RGA_STATUS			0x00c
+#define RGA_INT				0x010
+#define RGA_INT_ERROR			BIT(0)
+#define RGA_INT_MMU			BIT(1)
+#define RGA_INT_ALL_CMD_DONE		BIT(2)
+#define RGA_INT_CLEAR_ALL		(0xf << 4)
+#define RGA_INT_ERROR_EN		BIT(8)
+#define RGA_INT_MMU_EN			BIT(9)
+#define RGA_INT_ALL_CMD_DONE_EN		BIT(10)
+#define RGA_MMU_STA			0x01c
+#define RGA_VERSION			0x028
+
+/* The command buffer is loaded into the registers from 0x100 on */
+#define RGA_CMD_BASE			0x100
+#define RGA_CMD_WORDS			32
+
+/* Command buffer words: (register - RGA_CMD_BASE) / 4 */
+#define CMD_MODE_CTRL			(0x00 / 4)
+#define CMD_SRC_Y_MST			(0x04 / 4)
+#define CMD_SRC_VIR_INFO		(0x10 / 4)
+#define CMD_SRC_ACT_INFO		(0x14 / 4)
+#define CMD_SRC_X_PARA			(0x18 / 4)
+#define CMD_SRC_Y_PARA			(0x1c / 4)
+#define CMD_SRC_TILE_XINFO		(0x20 / 4)
+#define CMD_SRC_TILE_YINFO		(0x24 / 4)
+#define CMD_SRC_TILE_H_INCR		(0x28 / 4)
+#define CMD_SRC_TILE_V_INCR		(0x2c / 4)
+#define CMD_SRC_TILE_OFFSETX		(0x30 / 4)
+#define CMD_SRC_TILE_OFFSETY		(0x34 / 4)
+#define CMD_DST_MST			(0x4c / 4)
+#define CMD_DST_VIR_INFO		(0x50 / 4)
+#define CMD_DST_CTR_INFO		(0x54 / 4)
+#define CMD_ALPHA_CON			(0x58 / 4)
+#define CMD_MMU_CTRL			(0x68 / 4)
+#define CMD_MMU_TBL			(0x6c / 4)
+
+#define MODE_CTRL_ROTATE		(1 << 18)
+#define ALPHA_CON_GLOBAL_ALPHA(x)	((x) << 8)
+#define DST_CTR_INFO_FLAGS		(BIT(29) | BIT(28))
+#define MMU_CTRL_ENABLE			BIT(0)
+#define MMU_CTRL_FLUSH			(BIT(3) | BIT(2) | BIT(1))
+#define MMU_CTRL_PAGE_TABLE_SIZE(x)	((x) << 4)
+
+/* Room for the page table: 64 MiB of source and destination */
+#define RGA_TABLE_ENTRIES		16384
+/* Entries after source and destination that repeat their last page */
+#define RGA_TABLE_SPARE			16
+
+#define RGA_TIMEOUT_MS			500
+
+struct rockchip_rga1 {
+	struct device *dev;
+	void __iomem *regs;
+	struct clk_bulk_data *clks;
+	int num_clks;
+
+	/* serialises the jobs */
+	struct mutex lock;
+	struct completion done;
+	u32 int_status;
+
+	u32 *cmd;
+	dma_addr_t cmd_dma;
+	u32 *table;
+	dma_addr_t table_dma;
+
+	/* Statistics for debugfs, protected by lock */
+	u64 jobs;
+	u64 errors;
+	u64 total_us;
+	u64 total_pixels;
+	u32 max_us;
+	u32 last_us;
+};
+
+/* What the vendor driver calls TILE_INFO */
+struct rga1_tile {
+	s64 matrix[4];
+	s32 dst_x_tmp;
+	s32 dst_y_tmp;
+	s32 dst_w;
+	s32 dst_h;
+	s32 dst_x_off;
+	s32 dst_y_off;
+	s32 x_dx;
+	s32 x_dy;
+	s32 y_dx;
+	s32 y_dy;
+	s32 tile_xoff;
+	s32 tile_yoff;
+	u16 tile_w;
+	u16 tile_h;
+	s16 tile_start_x_coor;
+	s16 tile_start_y_coor;
+};
+
+/* A rotating bitblt in the terms of the vendor's struct rga_req */
+struct rga1_blit {
+	u32 src_addr;
+	u32 src_vir_w;
+	u32 src_vir_h;
+	u32 src_act_w;
+	u32 src_act_h;
+	u32 dst_addr;
+	u32 dst_vir_w;
+	u32 dst_vir_h;
+	u32 dst_act_w;
+	u32 dst_act_h;
+	s32 dst_x_offset;
+	s32 dst_y_offset;
+	s32 sina;
+	s32 cosa;
+};
+
+static s64 min4(s64 a, s64 b, s64 c, s64 d)
+{
+	return min(min(a, b), min(c, d));
+}
+
+static s64 max4(s64 a, s64 b, s64 c, s64 d)
+{
+	return max(max(a, b), max(c, d));
+}
+
+/* matrix_cal() for rotate_mode 1, without scaling */
+static void rga1_matrix_cal(const struct rga1_blit *b, struct rga1_tile *t)
+{
+	s64 x_time = 1 << 16;
+	s64 y_time = 1 << 16;
+
+	t->matrix[0] = b->cosa * x_time;
+	t->matrix[1] = -b->sina * y_time;
+	t->matrix[2] = b->sina * x_time;
+	t->matrix[3] = b->cosa * y_time;
+}
+
+/*
+ * dst_ctrl_cal() for rotate_mode 1 and 90 or 270 degrees, with the clip
+ * window set to the whole destination
+ */
+static void rga1_dst_ctrl_cal(const struct rga1_blit *b, struct rga1_tile *t)
+{
+	s32 w = b->dst_act_w;
+	s32 h = b->dst_act_h;
+	s32 xoff = b->dst_x_offset;
+	s32 yoff = b->dst_y_offset;
+	s32 pos[8];
+	s32 xmin;
+	s32 xmax;
+	s32 ymin;
+	s32 ymax;
+
+	if (b->sina > 0) {
+		/* 90 degrees: (xoff, yoff) is the top right corner */
+		pos[0] = xoff - h + 1;
+		pos[1] = yoff;
+		pos[2] = xoff - h + 1;
+		pos[3] = yoff + w - 1;
+		pos[4] = xoff;
+		pos[5] = yoff + w - 1;
+		pos[6] = xoff;
+		pos[7] = yoff;
+	} else {
+		/* 270 degrees: (xoff, yoff) is the bottom left corner */
+		pos[0] = xoff;
+		pos[1] = yoff - w + 1;
+		pos[2] = xoff;
+		pos[3] = yoff;
+		pos[4] = xoff + h - 1;
+		pos[5] = yoff;
+		pos[6] = xoff + h - 1;
+		pos[7] = yoff - w + 1;
+	}
+
+	xmax = min_t(s32, max4(pos[0], pos[2], pos[4], pos[6]), b->dst_vir_w - 1);
+	xmin = max_t(s32, min4(pos[0], pos[2], pos[4], pos[6]), 0);
+	ymax = min_t(s32, max4(pos[1], pos[3], pos[5], pos[7]), b->dst_vir_h - 1);
+	ymin = max_t(s32, min4(pos[1], pos[3], pos[5], pos[7]), 0);
+
+	t->dst_w = xmax - xmin;
+	t->dst_h = ymax - ymin;
+	t->dst_x_off = xmin;
+	t->dst_y_off = ymin;
+	t->dst_x_tmp = xmin - b->dst_x_offset;
+	t->dst_y_tmp = ymin - b->dst_y_offset;
+}
+
+/* src_tile_info_cal() for rotate_mode 1 */
+static void rga1_src_tile_info_cal(struct rga1_tile *t)
+{
+	s64 xx = t->matrix[0];
+	s64 xy = t->matrix[1];
+	s64 yx = t->matrix[2];
+	s64 yy = t->matrix[3];
+	s64 x0 = t->dst_x_tmp;
+	s64 y0 = t->dst_y_tmp;
+	s64 pos[8];
+	s64 epos[8];
+	s64 x_start;
+	s64 y_start;
+	s64 xmin;
+	s64 xmax;
+	s64 ymin;
+	s64 ymax;
+
+	/* Corners of the first 8x8 destination tile in the source */
+	pos[0] = x0 * xx + y0 * yx;
+	pos[1] = x0 * xy + y0 * yy;
+	pos[2] = x0 * xx + (y0 + 8) * yx;
+	pos[3] = x0 * xy + (y0 + 8) * yy;
+	pos[6] = (x0 + 8) * xx + y0 * yx;
+	pos[7] = (x0 + 8) * xy + y0 * yy;
+
+	epos[0] = pos[0];
+	epos[1] = pos[1];
+	epos[2] = x0 * xx + (y0 + 7) * yx;
+	epos[3] = x0 * xy + (y0 + 7) * yy;
+	epos[4] = (x0 + 7) * xx + (y0 + 7) * yx;
+	epos[5] = (x0 + 7) * xy + (y0 + 7) * yy;
+	epos[6] = (x0 + 7) * xx + y0 * yx;
+	epos[7] = (x0 + 7) * xy + y0 * yy;
+
+	t->x_dx = (s32)((pos[6] - pos[0]) >> 22);
+	t->x_dy = (s32)((pos[7] - pos[1]) >> 22);
+	t->y_dx = (s32)((pos[2] - pos[0]) >> 22);
+	t->y_dy = (s32)((pos[3] - pos[1]) >> 22);
+
+	x_start = x0 * xx + y0 * yx;
+	y_start = x0 * xy + y0 * yy;
+
+	xmax = max4(epos[0], epos[2], epos[4], epos[6]);
+	xmin = min4(epos[0], epos[2], epos[4], epos[6]);
+	ymax = max4(epos[1], epos[3], epos[5], epos[7]);
+	ymin = min4(epos[1], epos[3], epos[5], epos[7]);
+
+	t->tile_xoff = (s32)((x_start - xmin) >> 18);
+	t->tile_yoff = (s32)((y_start - ymin) >> 18);
+	t->tile_w = (u16)((xmax - xmin) >> 21);
+	t->tile_h = (u16)((ymax - ymin) >> 21);
+	t->tile_start_x_coor = (s16)(xmin >> 29);
+	t->tile_start_y_coor = (s16)(ymin >> 29);
+}
+
+/*
+ * The command buffer for a rotating bitblt from RGBA8888 to RGBA8888, which
+ * copies the 32 bits of every pixel unchanged
+ */
+static void rga1_gen_cmd(const struct rga1_blit *b, u32 table_dma, u32 *cmd)
+{
+	struct rga1_tile t = { };
+	u32 src_stride = b->src_vir_w * 4;
+	u32 dst_stride = b->dst_vir_w * 4;
+	u32 rop_mask_stride = (((b->src_vir_w + 7) >> 3) + 3) & ~3;
+	s32 m[4];
+	s32 pos[8];
+	s32 xmin;
+	s32 xmax;
+	s32 ymin;
+	s32 ymax;
+	s32 xp;
+	s32 yp;
+	int i;
+
+	memset(cmd, 0, RGA_CMD_WORDS * 4);
+
+	cmd[CMD_MODE_CTRL] = MODE_CTRL_ROTATE;
+	cmd[CMD_ALPHA_CON] = ALPHA_CON_GLOBAL_ALPHA(0xff);
+	cmd[CMD_SRC_VIR_INFO] = (src_stride >> 2) | (b->src_vir_h << 16);
+	cmd[CMD_SRC_ACT_INFO] = (b->src_act_w - 1) | ((b->src_act_h - 1) << 16);
+	cmd[CMD_DST_VIR_INFO] = ((dst_stride >> 2) & 0xffff) |
+				((rop_mask_stride >> 2) << 16);
+
+	rga1_matrix_cal(b, &t);
+	rga1_dst_ctrl_cal(b, &t);
+	rga1_src_tile_info_cal(&t);
+
+	for (i = 0; i < 4; i++)
+		m[i] = (s32)(t.matrix[i] >> 18);
+
+	cmd[CMD_SRC_X_PARA] = (m[0] & 0xffff) | (m[2] << 16);
+	cmd[CMD_SRC_Y_PARA] = (m[1] & 0xffff) | (m[3] << 16);
+	cmd[CMD_SRC_TILE_XINFO] = (t.tile_start_x_coor & 0xffff) | (t.tile_w << 16);
+	cmd[CMD_SRC_TILE_YINFO] = (t.tile_start_y_coor & 0xffff) | (t.tile_h << 16);
+	cmd[CMD_SRC_TILE_H_INCR] = (t.x_dx & 0xffff) | (t.x_dy << 16);
+	cmd[CMD_SRC_TILE_V_INCR] = (t.y_dx & 0xffff) | (t.y_dy << 16);
+	cmd[CMD_SRC_TILE_OFFSETX] = t.tile_xoff;
+	cmd[CMD_SRC_TILE_OFFSETY] = t.tile_yoff;
+
+	/* Source address of the first tile */
+	pos[0] = t.tile_start_x_coor << 8;
+	pos[1] = t.tile_start_y_coor << 8;
+	pos[2] = pos[0];
+	pos[3] = pos[1] + t.tile_h;
+	pos[4] = pos[0] + t.tile_w;
+	pos[5] = pos[1] + t.tile_h;
+	pos[6] = pos[0] + t.tile_w;
+	pos[7] = pos[1];
+
+	for (i = 0; i < 8; i++)
+		pos[i] >>= 11;
+
+	xmax = max4(pos[0], pos[2], pos[4], pos[6]) + 1;
+	xmin = min4(pos[0], pos[2], pos[4], pos[6]);
+	ymax = max4(pos[1], pos[3], pos[5], pos[7]) + 1;
+	ymin = min4(pos[1], pos[3], pos[5], pos[7]);
+
+	xp = xmin;
+	yp = ymin;
+	if (!(xmax < 0 || xmin > (s32)b->src_act_w - 1 ||
+	      ymax < 0 || ymin > (s32)b->src_act_h - 1)) {
+		xp = clamp_t(s32, xp, 0, b->src_act_w - 1);
+		yp = clamp_t(s32, yp, 0, b->src_act_h - 1);
+	}
+
+	cmd[CMD_SRC_Y_MST] = b->src_addr + yp * src_stride + xp * 4;
+	cmd[CMD_DST_MST] = b->dst_addr + t.dst_y_off * dst_stride + t.dst_x_off * 4;
+	cmd[CMD_DST_CTR_INFO] = t.dst_w | (t.dst_h << 16) | DST_CTR_INFO_FLAGS;
+
+	cmd[CMD_MMU_TBL] = table_dma >> 2;
+	cmd[CMD_MMU_CTRL] = MMU_CTRL_PAGE_TABLE_SIZE(2) | MMU_CTRL_FLUSH |
+			    MMU_CTRL_ENABLE;
+}
+
+/*
+ * Enter the pages of an image into the page table from @first on, followed
+ * by spare entries. Returns the number of entries used.
+ */
+static int rga1_map_image(struct rockchip_rga1 *rga,
+			  const struct rockchip_rga1_image *image,
+			  unsigned int first)
+{
+	unsigned int pages = DIV_ROUND_UP(image->size, PAGE_SIZE);
+	unsigned int i = 0;
+	struct sg_page_iter iter;
+
+	if (first + pages + RGA_TABLE_SPARE > RGA_TABLE_ENTRIES)
+		return -E2BIG;
+
+	if (image->sgt) {
+		for_each_sgtable_page(image->sgt, &iter, 0) {
+			if (i == pages)
+				break;
+
+			rga->table[first + i] = page_to_phys(sg_page_iter_page(&iter));
+			i++;
+		}
+
+		if (i < pages)
+			return -EINVAL;
+	} else {
+		for (i = 0; i < pages; i++)
+			rga->table[first + i] = image->phys + i * PAGE_SIZE;
+	}
+
+	for (i = 0; i < RGA_TABLE_SPARE; i++)
+		rga->table[first + pages + i] = rga->table[first + pages - 1];
+
+	return pages + RGA_TABLE_SPARE;
+}
+
+static bool rga1_image_fits(const struct rockchip_rga1_image *image)
+{
+	u64 end = image->offset + (u64)image->pitch * (image->height - 1) +
+		  image->width * 4;
+
+	return image->width && image->height && image->pitch % 4 == 0 &&
+	       image->pitch >= image->width * 4 && end <= image->size;
+}
+
+static void rga1_soft_reset(struct rockchip_rga1 *rga)
+{
+	int i;
+
+	writel(RGA_SYS_CTRL_SOFT_RESET, rga->regs + RGA_SYS_CTRL);
+
+	for (i = 0; i < 1000; i++) {
+		if (!(readl(rga->regs + RGA_SYS_CTRL) & RGA_SYS_CTRL_SOFT_RESET))
+			break;
+
+		udelay(1);
+	}
+}
+
+/**
+ * rockchip_rga1_rotate - rotate a 32 bpp image
+ * @rga: the RGA
+ * @src: source image
+ * @dst: destination image, @src->height wide and @src->width high
+ * @degrees: 90 or 270, clockwise
+ *
+ * Sleeps until the RGA has finished.
+ */
+int rockchip_rga1_rotate(struct rockchip_rga1 *rga,
+			 const struct rockchip_rga1_image *src,
+			 const struct rockchip_rga1_image *dst,
+			 unsigned int degrees)
+{
+	struct rga1_blit b = { };
+	unsigned long timeout;
+	ktime_t start;
+	s64 elapsed;
+	int src_entries;
+	int dst_entries;
+	u32 status;
+	int ret;
+
+	if (degrees != 90 && degrees != 270)
+		return -EINVAL;
+
+	if (!rga1_image_fits(src) || !rga1_image_fits(dst) ||
+	    dst->width != src->height || dst->height != src->width)
+		return -EINVAL;
+
+	mutex_lock(&rga->lock);
+
+	src_entries = rga1_map_image(rga, src, 0);
+	if (src_entries < 0) {
+		ret = src_entries;
+		goto out_unlock;
+	}
+
+	dst_entries = rga1_map_image(rga, dst, src_entries);
+	if (dst_entries < 0) {
+		ret = dst_entries;
+		goto out_unlock;
+	}
+
+	b.src_addr = src->offset;
+	b.src_vir_w = src->pitch / 4;
+	b.src_vir_h = src->height;
+	b.src_act_w = src->width;
+	b.src_act_h = src->height;
+	b.dst_addr = (src_entries << PAGE_SHIFT) + dst->offset;
+	b.dst_vir_w = dst->pitch / 4;
+	b.dst_vir_h = dst->height;
+	b.dst_act_w = src->width;
+	b.dst_act_h = src->height;
+	b.cosa = 0;
+
+	if (degrees == 90) {
+		b.sina = 65536;
+		b.dst_x_offset = dst->width - 1;
+		b.dst_y_offset = 0;
+	} else {
+		b.sina = -65536;
+		b.dst_x_offset = 0;
+		b.dst_y_offset = dst->height - 1;
+	}
+
+	rga1_gen_cmd(&b, rga->table_dma, rga->cmd);
+
+	ret = pm_runtime_resume_and_get(rga->dev);
+	if (ret < 0)
+		goto out_unlock;
+
+	ret = clk_bulk_prepare_enable(rga->num_clks, rga->clks);
+	if (ret)
+		goto out_put;
+
+	rga1_soft_reset(rga);
+	writel(0, rga->regs + RGA_SYS_CTRL);
+
+	/*
+	 * Like the vendor driver: clear the MMU control register before the
+	 * command buffer sets it again, otherwise the MMU keeps translations
+	 * of the previous job and faults.
+	 */
+	writel(0, rga->regs + RGA_CMD_BASE + CMD_MMU_CTRL * 4);
+
+	writel(rga->cmd_dma, rga->regs + RGA_CMD_ADDR);
+	writel(RGA_SYS_CTRL_CMD_MODE | RGA_SYS_CTRL_MASTER_MODE,
+	       rga->regs + RGA_SYS_CTRL);
+	writel(readl(rga->regs + RGA_INT) | RGA_INT_ALL_CMD_DONE_EN |
+	       RGA_INT_MMU_EN | RGA_INT_ERROR_EN, rga->regs + RGA_INT);
+
+	rga->int_status = 0;
+	reinit_completion(&rga->done);
+	start = ktime_get();
+	writel(RGA_CMD_CTRL_START, rga->regs + RGA_CMD_CTRL);
+
+	timeout = wait_for_completion_timeout(&rga->done,
+					      msecs_to_jiffies(RGA_TIMEOUT_MS));
+	status = rga->int_status;
+	elapsed = ktime_us_delta(ktime_get(), start);
+
+	if (!timeout) {
+		dev_err_ratelimited(rga->dev, "timeout, INT %08x STATUS %08x\n",
+				    readl(rga->regs + RGA_INT),
+				    readl(rga->regs + RGA_STATUS));
+		ret = -ETIMEDOUT;
+	} else if (status & (RGA_INT_ERROR | RGA_INT_MMU)) {
+		dev_err_ratelimited(rga->dev, "error, INT %08x MMU %08x\n",
+				    status, readl(rga->regs + RGA_MMU_STA));
+		ret = -EIO;
+	}
+
+	if (ret) {
+		rga1_soft_reset(rga);
+		rga->errors++;
+	} else {
+		rga->jobs++;
+		rga->total_us += elapsed;
+		rga->total_pixels += src->width * src->height;
+		rga->last_us = elapsed;
+		rga->max_us = max_t(u32, rga->max_us, elapsed);
+	}
+
+	clk_bulk_disable_unprepare(rga->num_clks, rga->clks);
+
+out_put:
+	pm_runtime_put(rga->dev);
+out_unlock:
+	mutex_unlock(&rga->lock);
+	return ret;
+}
+
+static int rga1_stats_show(struct seq_file *m, void *data)
+{
+	struct rockchip_rga1 *rga = m->private;
+
+	mutex_lock(&rga->lock);
+	seq_printf(m, "jobs %llu errors %llu average_us %llu average_pixels %llu max_us %u last_us %u\n",
+		   rga->jobs, rga->errors,
+		   rga->jobs ? div64_u64(rga->total_us, rga->jobs) : 0,
+		   rga->jobs ? div64_u64(rga->total_pixels, rga->jobs) : 0,
+		   rga->max_us, rga->last_us);
+	mutex_unlock(&rga->lock);
+
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(rga1_stats);
+
+static irqreturn_t rga1_irq(int irq, void *data)
+{
+	struct rockchip_rga1 *rga = data;
+	u32 status = readl(rga->regs + RGA_INT);
+
+	if (!(status & (RGA_INT_ALL_CMD_DONE | RGA_INT_MMU | RGA_INT_ERROR)))
+		return IRQ_NONE;
+
+	writel(status | RGA_INT_CLEAR_ALL, rga->regs + RGA_INT);
+	rga->int_status = status;
+	complete(&rga->done);
+
+	return IRQ_HANDLED;
+}
+
+/**
+ * rockchip_rga1_get - the RGA that the "rockchip,rga" property of a device
+ *		       points to
+ * @dev: the device
+ *
+ * Returns NULL without the property, ERR_PTR(-EPROBE_DEFER) while the RGA
+ * is not probed yet.
+ */
+struct rockchip_rga1 *rockchip_rga1_get(struct device *dev)
+{
+	struct device_node *np;
+	struct platform_device *pdev;
+	struct rockchip_rga1 *rga;
+
+	np = of_parse_phandle(dev->of_node, "rockchip,rga", 0);
+	if (!np)
+		return NULL;
+
+	pdev = of_find_device_by_node(np);
+	of_node_put(np);
+	if (!pdev)
+		return ERR_PTR(-EPROBE_DEFER);
+
+	rga = platform_get_drvdata(pdev);
+	put_device(&pdev->dev);
+	if (!rga)
+		return ERR_PTR(-EPROBE_DEFER);
+
+	return rga;
+}
+
+static int rga1_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct rockchip_rga1 *rga;
+	int irq;
+	int ret;
+
+	rga = devm_kzalloc(dev, sizeof(*rga), GFP_KERNEL);
+	if (!rga)
+		return -ENOMEM;
+
+	rga->dev = dev;
+	mutex_init(&rga->lock);
+	init_completion(&rga->done);
+
+	rga->regs = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(rga->regs))
+		return PTR_ERR(rga->regs);
+
+	rga->num_clks = devm_clk_bulk_get_all(dev, &rga->clks);
+	if (rga->num_clks < 0)
+		return dev_err_probe(dev, rga->num_clks, "no clocks\n");
+
+	irq = platform_get_irq(pdev, 0);
+	if (irq < 0)
+		return irq;
+
+	ret = devm_request_irq(dev, irq, rga1_irq, 0, dev_name(dev), rga);
+	if (ret)
+		return ret;
+
+	ret = dma_set_mask_and_coherent(dev, DMA_BIT_MASK(32));
+	if (ret)
+		return ret;
+
+	rga->cmd = dmam_alloc_coherent(dev, RGA_CMD_WORDS * 4, &rga->cmd_dma,
+				       GFP_KERNEL);
+	rga->table = dmam_alloc_coherent(dev, RGA_TABLE_ENTRIES * 4,
+					 &rga->table_dma, GFP_KERNEL);
+	if (!rga->cmd || !rga->table)
+		return -ENOMEM;
+
+	ret = devm_pm_runtime_enable(dev);
+	if (ret)
+		return ret;
+
+	ret = pm_runtime_resume_and_get(dev);
+	if (ret < 0)
+		return ret;
+
+	ret = clk_bulk_prepare_enable(rga->num_clks, rga->clks);
+	if (ret) {
+		pm_runtime_put(dev);
+		return ret;
+	}
+
+	dev_info(dev, "RGA version %08x\n", readl(rga->regs + RGA_VERSION));
+
+	clk_bulk_disable_unprepare(rga->num_clks, rga->clks);
+	pm_runtime_put(dev);
+
+	debugfs_create_file("rockchip-rga1", 0444, NULL, rga, &rga1_stats_fops);
+
+	platform_set_drvdata(pdev, rga);
+	return 0;
+}
+
+static const struct of_device_id rga1_dt_ids[] = {
+	{ .compatible = "rockchip,rk3128-rga" },
+	{ /* sentinel */ },
+};
+
+struct platform_driver rockchip_rga1_driver = {
+	.probe = rga1_probe,
+	.driver = {
+		.name = "rockchip-rga1",
+		.of_match_table = rga1_dt_ids,
+		.suppress_bind_attrs = true,
+	},
+};
--- /dev/null
+++ b/drivers/gpu/drm/rockchip/rockchip_rga1.h
@@ -0,0 +1,51 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * RGA (version 1) of the RK3126/RK3128, used by the VOP driver to rotate
+ * the output for panels that are mounted rotated.
+ */
+
+#ifndef _ROCKCHIP_RGA1_H
+#define _ROCKCHIP_RGA1_H
+
+#include <linux/device.h>
+#include <linux/scatterlist.h>
+
+struct rockchip_rga1;
+
+/*
+ * A 32 bit per pixel image. The RGA reads and writes it through its own MMU,
+ * so the buffer does not need to be contiguous: @sgt lists its pages. Without
+ * @sgt, the buffer is contiguous and starts at the physical address @phys.
+ */
+struct rockchip_rga1_image {
+	struct sg_table *sgt;
+	phys_addr_t phys;
+	size_t size;
+	unsigned int offset;
+	unsigned int pitch;
+	unsigned int width;
+	unsigned int height;
+};
+
+#if IS_ENABLED(CONFIG_ROCKCHIP_VOP)
+struct rockchip_rga1 *rockchip_rga1_get(struct device *dev);
+int rockchip_rga1_rotate(struct rockchip_rga1 *rga,
+			 const struct rockchip_rga1_image *src,
+			 const struct rockchip_rga1_image *dst,
+			 unsigned int degrees);
+#else
+static inline struct rockchip_rga1 *rockchip_rga1_get(struct device *dev)
+{
+	return NULL;
+}
+
+static inline int rockchip_rga1_rotate(struct rockchip_rga1 *rga,
+				       const struct rockchip_rga1_image *src,
+				       const struct rockchip_rga1_image *dst,
+				       unsigned int degrees)
+{
+	return -ENODEV;
+}
+#endif
+
+#endif /* _ROCKCHIP_RGA1_H */
