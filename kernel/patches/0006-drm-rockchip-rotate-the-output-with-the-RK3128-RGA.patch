+/* Swaps the horizontal and vertical timings of a mode */
+static void vop_rotate_mode(struct drm_display_mode *mode)
+{
+	u32 flags = mode->flags;
+
+	swap(mode->hdisplay, mode->vdisplay);
+	swap(mode->hsync_start, mode->vsync_start);
+	swap(mode->hsync_end, mode->vsync_end);
+	swap(mode->htotal, mode->vtotal);
+	swap(mode->width_mm, mode->height_mm);
+	mode->hskew = 0;
+
+	mode->flags &= ~(DRM_MODE_FLAG_PHSYNC | DRM_MODE_FLAG_NHSYNC |
+			 DRM_MODE_FLAG_PVSYNC | DRM_MODE_FLAG_NVSYNC);
+	if (flags & DRM_MODE_FLAG_PHSYNC)
+		mode->flags |= DRM_MODE_FLAG_PVSYNC;
+	if (flags & DRM_MODE_FLAG_NHSYNC)
+		mode->flags |= DRM_MODE_FLAG_NVSYNC;
+	if (flags & DRM_MODE_FLAG_PVSYNC)
+		mode->flags |= DRM_MODE_FLAG_PHSYNC;
+	if (flags & DRM_MODE_FLAG_NVSYNC)
+		mode->flags |= DRM_MODE_FLAG_NHSYNC;
+
+	drm_mode_set_crtcinfo(mode, CRTC_INTERLACE_HALVE_V);
+}
