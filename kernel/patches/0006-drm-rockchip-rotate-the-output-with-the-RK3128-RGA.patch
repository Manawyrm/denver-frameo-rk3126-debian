+/*
+ * With output rotation, the primary plane has to cover the whole CRTC
+ * unscaled, with a linear 32 bpp framebuffer the RGA can rotate.
+ */
+static int vop_plane_check_rotation(struct drm_plane_state *plane_state,
+				    struct drm_crtc_state *crtc_state)
+{
+	struct drm_framebuffer *fb = plane_state->fb;
+	struct drm_rect *src = &plane_state->src;
+	struct drm_rect *dst = &plane_state->dst;
+
+	if (plane_state->plane->type != DRM_PLANE_TYPE_PRIMARY)
+		return -EINVAL;
+
+	if (fb->format->cpp[0] != 4 || fb->format->is_yuv ||
+	    fb->modifier != DRM_FORMAT_MOD_LINEAR) {
+		DRM_DEBUG_KMS("rotated output: unsupported framebuffer\n");
+		return -EINVAL;
+	}
+
+	if (dst->x1 != 0 || dst->y1 != 0 ||
+	    drm_rect_width(dst) != crtc_state->mode.hdisplay ||
+	    drm_rect_height(dst) != crtc_state->mode.vdisplay ||
+	    drm_rect_width(src) >> 16 != drm_rect_width(dst) ||
+	    drm_rect_height(src) >> 16 != drm_rect_height(dst) ||
+	    (src->x1 | src->y1) & 0xffff) {
+		DRM_DEBUG_KMS("rotated output: plane must cover the CRTC unscaled\n");
+		return -EINVAL;
+	}
+
+	return 0;
+}
