 /*
  * Initialize the vop->win array elements.
  */
+/*
+ * Output rotation with the RGA, for panels that are mounted rotated
+ * ("rockchip,output-rotation" in degrees clockwise, 90 or 270, and
+ * "rockchip,rga" in the VOP node). Userspace sees rotated modes and a
+ * primary plane in that orientation; the RGA rotates every new framebuffer
+ * into the orientation of the panel in the commit tail.
+ */
+static int vop_rotation_setup(struct vop *vop)
+{
+	struct rockchip_rga1 *rga;
+	u32 rotation;
+
+	if (of_property_read_u32(vop->dev->of_node, "rockchip,output-rotation",
+				 &rotation))
+		return 0;
+
+	if (rotation != 90 && rotation != 270) {
+		DRM_DEV_ERROR(vop->dev, "unsupported output rotation %u\n",
+			      rotation);
+		return 0;
+	}
+
+	if (!rga_rotation) {
+		DRM_DEV_INFO(vop->dev,
+			     "output rotation off (rockchipdrm.rga_rotation=1)\n");
+		return 0;
+	}
+
+	rga = rockchip_rga1_get(vop->dev);
+	if (IS_ERR(rga))
+		return PTR_ERR(rga);
+
+	if (!rga) {
+		DRM_DEV_ERROR(vop->dev, "output rotation needs rockchip,rga\n");
+		return 0;
+	}
+
+	vop->rga = rga;
+	vop->rotation = rotation;
+	DRM_DEV_INFO(vop->dev, "output rotated by %u degrees with the RGA\n",
+		     rotation);
+
+	return 0;
+}
+
+static void vop_rotation_free(struct vop *vop)
+{
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(vop->rot_buf); i++) {
+		if (vop->rot_buf[i])
+			drm_gem_object_put(&vop->rot_buf[i]->base);
+
+		vop->rot_buf[i] = NULL;
+	}
+
+	vop->rot_valid = false;
+}
+
+/* The buffers for the panel, allocated with the first rotation */
+static int vop_rotation_alloc(struct vop *vop, unsigned int size)
+{
+	struct rockchip_gem_object *rk_obj;
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(vop->rot_buf); i++) {
+		if (vop->rot_buf[i] && vop->rot_buf[i]->base.size >= size)
+			continue;
+
+		/* Only reached when the shown buffer is too small as well */
+		if (vop->rot_buf[i])
+			drm_gem_object_put(&vop->rot_buf[i]->base);
+
+		vop->rot_buf[i] = NULL;
+		vop->rot_valid = false;
+
+		rk_obj = rockchip_gem_create_object(vop->drm_dev, size, false);
+		if (IS_ERR(rk_obj))
+			return PTR_ERR(rk_obj);
+
+		vop->rot_buf[i] = rk_obj;
+	}
+
+	return 0;
+}
+
+/* Smallest rectangle around a and b, either may be empty */
+static void vop_rect_union(struct drm_rect *a, const struct drm_rect *b)
+{
+	if (!drm_rect_visible(b))
+		return;
+
+	if (!drm_rect_visible(a)) {
+		*a = *b;
+		return;
+	}
+
+	a->x1 = min(a->x1, b->x1);
+	a->y1 = min(a->y1, b->y1);
+	a->x2 = max(a->x2, b->x2);
+	a->y2 = max(a->y2, b->y2);
+}
+
+static void vop_rotation_image(struct rockchip_gem_object *rk_obj,
+			       struct rockchip_rga1_image *image)
+{
+	image->sgt = rk_obj->sgt;
+	image->phys = rk_obj->dma_addr;
+	image->size = rk_obj->base.size;
+}
+
+/*
+ * Rotate what changed in the framebuffer of the primary plane into the
+ * hidden buffer, together with what that buffer missed of the previous frame
+ */
+static void vop_rotate_plane(struct vop *vop, struct drm_plane_state *old_state,
+			     struct drm_plane_state *state,
+			     struct drm_crtc_state *crtc_state)
+{
+	struct drm_display_mode *native = &crtc_state->adjusted_mode;
+	struct drm_framebuffer *fb = state->fb;
+	struct rockchip_rga1_image src = { };
+	struct rockchip_rga1_image dst = { };
+	unsigned int width = drm_rect_width(&state->src) >> 16;
+	unsigned int height = drm_rect_height(&state->src) >> 16;
+	unsigned int src_x = state->src.x1 >> 16;
+	unsigned int src_y = state->src.y1 >> 16;
+	unsigned int back;
+	struct drm_rect plane_rect;
+	struct drm_rect damage;
+	struct drm_rect region;
+	int ret;
+
+	ret = vop_rotation_alloc(vop, native->hdisplay * native->vdisplay * 4);
+	if (ret) {
+		DRM_DEV_ERROR_RATELIMITED(vop->dev,
+					  "no buffers for the rotation: %d\n", ret);
+		return;
+	}
+
+	drm_rect_init(&plane_rect, 0, 0, width, height);
+
+	if (!vop->rot_valid || drm_atomic_crtc_needs_modeset(crtc_state)) {
+		vop->rot_missing[0] = plane_rect;
+		vop->rot_missing[1] = plane_rect;
+		damage = plane_rect;
+	} else if (drm_atomic_helper_damage_merged(old_state, state, &damage)) {
+		/* Framebuffer coordinates to plane coordinates, 8x8 aligned */
+		drm_rect_translate(&damage, -src_x, -src_y);
+		damage.x1 = round_down(damage.x1, 8);
+		damage.y1 = round_down(damage.y1, 8);
+		damage.x2 = round_up(damage.x2, 8);
+		damage.y2 = round_up(damage.y2, 8);
+		drm_rect_intersect(&damage, &plane_rect);
+	} else {
+		/* Nothing changed */
+		return;
+	}
+
+	back = vop->rot_valid ? !vop->rot_front : 0;
+	region = damage;
+	vop_rect_union(&region, &vop->rot_missing[back]);
+	drm_rect_intersect(&region, &plane_rect);
+	if (!drm_rect_visible(&region))
+		return;
+
+	vop_rotation_image(to_rockchip_obj(fb->obj[0]), &src);
+	src.offset = fb->offsets[0] + (src_y + region.y1) * fb->pitches[0] +
+		     (src_x + region.x1) * 4;
+	src.pitch = fb->pitches[0];
+	src.width = drm_rect_width(&region);
+	src.height = drm_rect_height(&region);
+
+	/* The region in the buffer for the panel */
+	vop_rotation_image(vop->rot_buf[back], &dst);
+	dst.pitch = native->hdisplay * 4;
+	dst.width = src.height;
+	dst.height = src.width;
+	if (vop->rotation == 90)
+		dst.offset = region.x1 * dst.pitch + (height - region.y2) * 4;
+	else
+		dst.offset = (width - region.x2) * dst.pitch + region.y1 * 4;
+
+	ret = rockchip_rga1_rotate(vop->rga, &src, &dst, vop->rotation);
+	if (ret) {
+		DRM_DEV_ERROR_RATELIMITED(vop->dev, "rotation failed: %d\n",
+					  ret);
+		return;
+	}
+
+	drm_rect_init(&vop->rot_missing[back], 0, 0, 0, 0);
+	vop_rect_union(&vop->rot_missing[!back], &damage);
+	vop->rot_front = back;
+	vop->rot_valid = true;
+}
+
+/**
+ * rockchip_drm_vop_rotate_planes - rotate the framebuffers of a commit
+ * @state: the commit, from its commit tail
+ *
+ * Runs before the planes are updated. The previous commit on the CRTC has
+ * flipped, so the buffer that is not shown is free.
+ */
+void rockchip_drm_vop_rotate_planes(struct drm_atomic_commit *state)
+{
+	struct drm_plane_state *old_state;
+	struct drm_plane_state *new_state;
+	struct drm_crtc_state *crtc_state;
+	struct drm_plane *plane;
+	struct vop *vop;
+	int i;
+
+	for_each_oldnew_plane_in_state(state, plane, old_state, new_state, i) {
+		if (!new_state->crtc || new_state->crtc->funcs != &vop_crtc_funcs)
+			continue;
+
+		vop = to_vop(new_state->crtc);
+		if (!vop->rotation || plane->type != DRM_PLANE_TYPE_PRIMARY)
+			continue;
+
+		crtc_state = drm_atomic_get_new_crtc_state(state,
+							   new_state->crtc);
+		if (!crtc_state || !crtc_state->active ||
+		    !new_state->visible || !new_state->fb)
+			continue;
+
+		/* Unchanged framebuffer without damage: still up to date */
+		if (vop->rot_valid && new_state->fb == old_state->fb &&
+		    !new_state->fb_damage_clips &&
+		    !drm_atomic_crtc_needs_modeset(crtc_state))
+			continue;
+
+		vop_rotate_plane(vop, old_state, new_state, crtc_state);
+	}
+}
+
+/*
+ * The connectors of a rotated output report rotated modes: the panel bridge
+ * gets a copy of its helper functions with this get_modes().
+ */
+struct vop_rotated_connector {
+	struct drm_connector_helper_funcs funcs;
+	const struct drm_connector_helper_funcs *orig;
+};
+
+static int vop_rotated_get_modes(struct drm_connector *connector)
+{
+	const struct vop_rotated_connector *rotated =
+		container_of(connector->helper_private,
+			     struct vop_rotated_connector, funcs);
+	struct drm_display_info *info = &connector->display_info;
+	struct drm_display_mode *mode;
+	int count;
+
+	count = rotated->orig->get_modes(connector);
+
+	/* probed_modes only holds the modes of this probe */
+	list_for_each_entry(mode, &connector->probed_modes, head) {
+		vop_rotate_mode(mode);
+		drm_mode_set_name(mode);
+	}
+
+	swap(info->width_mm, info->height_mm);
+
+	return count;
+}
+
+static void vop_rotate_connector(struct drm_connector *connector)
+{
+	struct vop_rotated_connector *rotated;
+
+	if (!connector->helper_private ||
+	    !connector->helper_private->get_modes ||
+	    connector->helper_private->get_modes == vop_rotated_get_modes)
+		return;
+
+	rotated = drmm_kzalloc(connector->dev, sizeof(*rotated), GFP_KERNEL);
+	if (!rotated)
+		return;
+
+	rotated->orig = connector->helper_private;
+	rotated->funcs = *connector->helper_private;
+	rotated->funcs.get_modes = vop_rotated_get_modes;
+	connector->helper_private = &rotated->funcs;
+
+	DRM_DEV_INFO(connector->dev->dev, "%s: modes rotated\n",
+		     connector->name);
+}
+
+/**
+ * rockchip_drm_vop_rotation_init - rotate the modes of rotated outputs
+ * @drm: the DRM device, with all components bound
+ */
+void rockchip_drm_vop_rotation_init(struct drm_device *drm)
+{
+	struct drm_connector_list_iter iter;
+	struct drm_connector *connector;
+	struct drm_encoder *encoder;
+	struct drm_crtc *crtc;
+
+	drm_for_each_crtc(crtc, drm) {
+		if (crtc->funcs != &vop_crtc_funcs || !to_vop(crtc)->rotation)
+			continue;
+
+		drm_connector_list_iter_begin(drm, &iter);
+		drm_for_each_connector_iter(connector, &iter) {
+			drm_connector_for_each_possible_encoder(connector, encoder) {
+				if (encoder->possible_crtcs & drm_crtc_mask(crtc)) {
+					vop_rotate_connector(connector);
+					break;
+				}
+			}
+		}
+		drm_connector_list_iter_end(&iter);
+	}
+}
