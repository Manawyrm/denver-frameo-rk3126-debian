From: picture-frame build
Subject: [PATCH] mmc: dw_mmc: survive an SDIO card that stops responding

From https://github.com/sunshineinabox/rk915/pull/1 (pkilar,
docs/mainline-linux-7.1-dw_mmc-sdio-robustness.patch):
- mask TXDR/RXDR when they fire with no PIO transfer to service, which
  otherwise becomes an interrupt storm when the RK915 stops responding
- arm the software data timeout for writes too, so a write to a dead
  card fails instead of waiting forever

Changed here: the write timeout is only armed for SDIO cards. It covers
the whole transfer but is sized from the per-access data timeout, and
the root filesystem of the frame is on an SD card on the same driver.
The masking is only a debug message: a stray TXDR follows every normal
PIO write, with the RK915 dozens of times per second.
---
--- a/drivers/mmc/host/dw_mmc.c
+++ b/drivers/mmc/host/dw_mmc.c
@@ -1553,6 +1553,33 @@
 	}
 }
 
+/*
+ * TXDR/RXDR ask for the FIFO to be serviced by the CPU. If there is no transfer
+ * left to service - host->sg is NULL - the handler can only clear the latch, the
+ * underlying FIFO condition persists, and the level-triggered line is re-raised
+ * immediately. Mask the bit; dw_mci_submit_data() re-enables it for the next PIO
+ * transfer.
+ *
+ * This also happens at the end of every normal PIO write (TXDR once the last
+ * data has left the FIFO), dozens of times per second with SDIO WiFi, so it is
+ * only a debug message.
+ */
+static void dw_mci_mask_stuck_fifo_irq(struct dw_mci *host, u32 bit)
+{
+	unsigned long irqflags;
+	u32 int_mask;
+
+	spin_lock_irqsave(&host->irq_lock, irqflags);
+	int_mask = mci_readl(host, INTMASK);
+	if (int_mask & bit) {
+		mci_writel(host, INTMASK, int_mask & ~bit);
+		dev_dbg_ratelimited(host->dev,
+				    "FIFO irq %#x with no transfer to service; masking\n",
+				    bit);
+	}
+	spin_unlock_irqrestore(&host->irq_lock, irqflags);
+}
+
 static void __dw_mci_enable_sdio_irq(struct dw_mci *host, int enb)
 {
 	unsigned long irqflags;
@@ -1860,6 +1887,22 @@
 	return data->error;
 }
 
+/*
+ * The software data timeout is armed for reads and, on SDIO cards, for writes
+ * too. It covers the whole transfer but is sized from the per-access data
+ * timeout, so it is not armed for writes to memory cards: a long multi-block
+ * write to a slow SD card would hit it although nothing is wrong.
+ */
+static bool dw_mci_needs_drto(struct dw_mci *host)
+{
+	struct mmc_card *card = host->mmc->card;
+
+	if (host->dir_status == MMC_DATA_READ)
+		return true;
+
+	return card && mmc_card_sdio(card);
+}
+
 static void dw_mci_set_drto(struct dw_mci *host)
 {
 	const struct dw_mci_drv_data *drv_data = host->drv_data;
@@ -2024,9 +2067,13 @@
 						&host->pending_events)) {
 				/*
 				 * If all data-related interrupts don't come
-				 * within the given time in reading data state.
+				 * within the given time. Armed for SDIO writes
+				 * too: the hardware data timeout does not cover
+				 * the write data phase, so a write to a card
+				 * that has stopped responding otherwise leaves
+				 * mmc_wait_for_req() waiting forever.
 				 */
-				if (host->dir_status == MMC_DATA_READ)
+				if (dw_mci_needs_drto(host))
 					dw_mci_set_drto(host);
 				break;
 			}
@@ -2062,11 +2109,11 @@
 		case STATE_DATA_BUSY:
 			if (!dw_mci_clear_pending_data_complete(host)) {
 				/*
-				 * If data error interrupt comes but data over
-				 * interrupt doesn't come within the given time.
-				 * in reading data state.
+				 * If a data error interrupt comes but data over
+				 * does not follow within the given time. Armed
+				 * for SDIO writes as well, for the reason above.
 				 */
-				if (host->dir_status == MMC_DATA_READ)
+				if (dw_mci_needs_drto(host))
 					dw_mci_set_drto(host);
 				break;
 			}
@@ -2748,12 +2795,16 @@
 			mci_writel(host, RINTSTS, SDMMC_INT_RXDR);
 			if (host->dir_status == MMC_DATA_READ && host->sg)
 				dw_mci_read_data_pio(host, false);
+			else
+				dw_mci_mask_stuck_fifo_irq(host, SDMMC_INT_RXDR);
 		}
 
 		if (pending & SDMMC_INT_TXDR) {
 			mci_writel(host, RINTSTS, SDMMC_INT_TXDR);
 			if (host->dir_status == MMC_DATA_WRITE && host->sg)
 				dw_mci_write_data_pio(host);
+			else
+				dw_mci_mask_stuck_fifo_irq(host, SDMMC_INT_TXDR);
 		}
 
 		if (pending & SDMMC_INT_CMD_DONE) {
