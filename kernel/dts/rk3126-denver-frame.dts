// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
/*
 * Denver Frameo picture frame (RK3126B, "F606C" board by ZhiHeXing).
 *
 * Derived from the device tree of the stock Android firmware
 * (resource partition, rk-kernel.dtb):
 *
 *   display     800x1280 MIPI DSI, 4 lanes, JD9365 controller with the
 *               same init sequence as the Chongzhou CZ101B4001 panel
 *   backlight   PWM0, 40 kHz
 *   panel power GPIO0_A2 (active low), GPIO1_B1 (active low),
 *               reset GPIO2_B0
 *   touch       GSL3673 on I2C0 0x40, IRQ GPIO2_C3, power GPIO2_C2
 *   buttons     SARADC channel 2 (volume up/down), power GPIO2_B6
 *   WiFi        RK915 on SDIO, power GPIO1_B0, wakeup GPIO2_C1
 *   audio       internal codec on the 2-channel I2S, speaker amplifier
 *               enable GPIO2_C0
 *   power off   GPIO2_B5 (power hold, active low = off)
 *
 * vdd_arm comes from a PWM controlled DC/DC converter on PWM1, vdd_logic
 * from a fixed one (board rails "AVDD" and "CVDD", voltages measured).
 *
 * UART2 (GPIO1_C2/C3) shares its pins with SDMMC_D0/D1. This device tree
 * keeps them on the UART (SD card in 1-bit mode without D0, only usable
 * from U-Boot); rk3126-denver-frame-sdroot.dts gives D0 to the SD card for
 * a root filesystem on it.
 */

/dts-v1/;

#include <dt-bindings/input/input.h>
#include "rk3128.dtsi"

/*
 * The SoC is an RK3126B: a few clock gates differ from the RK3128.
 *
 * CPLL at 800 MHz instead of 500 MHz, for a real 400 MHz GPU clock
 * (CPLL/2, see the GPU). The clocks below CPLL that no driver sets get
 * fixed rates: pclk_pmu 80 MHz (800/10, was 83 MHz), hclk_vio moves to
 * GPLL at 118.8 MHz (594/5, was 125 MHz). eMMC, SDIO, UART and I2S drivers
 * set their own rates.
 */
&cru {
	compatible = "rockchip,rk3126-cru";
	assigned-clocks = <&cru PLL_GPLL>, <&cru PLL_CPLL>,
			  <&cru PCLK_PMU_PRE>, <&cru HCLK_VIO>;
	assigned-clock-parents = <0>, <0>, <0>, <&cru PLL_GPLL>;
	assigned-clock-rates = <594000000>, <800000000>,
			       <80000000>, <118800000>;
};

&cpu0 {
	cpu-supply = <&vdd_arm>;
};

/*
 * Voltages are real (measured curve of vdd_arm, see the regulator), the
 * limits found with a self-checking stress test on all four cores
 * (2026-10-15): 816 MHz runs at the lowest possible 1.241 V, 1008 MHz needs
 * about 1.36 V, 1104 MHz 1.44 V, 1200 MHz 1.52 V; 1296 MHz fails even at
 * the regulator maximum of 1.546 V. The stock voltage for 1008 MHz
 * (1.2 V nominal, 1.27 V real) is too low and produces wrong results.
 *
 * 1008 and 1104 MHz get about 60 mV of margin. 1200 MHz is only reached at
 * the regulator maximum (25 mV margin), so it is a turbo OPP: used only
 * after "echo 1 > /sys/devices/system/cpu/cpufreq/boost". The chip reached
 * about 53 degrees C at 1200 MHz under full load. There is no temperature
 * sensor.
 */
&cpu_opp_table {
	opp-216000000 {
		opp-microvolt = <1241000 1241000 1546000>;
	};
	opp-408000000 {
		opp-microvolt = <1241000 1241000 1546000>;
	};
	opp-600000000 {
		opp-microvolt = <1241000 1241000 1546000>;
	};
	opp-696000000 {
		opp-microvolt = <1241000 1241000 1546000>;
	};
	opp-816000000 {
		opp-microvolt = <1241000 1241000 1546000>;
	};
	opp-1008000000 {
		opp-microvolt = <1425000 1425000 1546000>;
	};
	opp-1104000000 {
		opp-hz = /bits/ 64 <1104000000>;
		opp-microvolt = <1500000 1500000 1546000>;
		clock-latency-ns = <40000>;
	};
	opp-1200000000 {
		opp-microvolt = <1546000 1546000 1546000>;
		turbo-mode;
	};
};

/ {
	model = "Denver Frameo picture frame (RK3126)";
	/* rk3126: the RK915 driver picks its SDIO clock per channel by SoC */
	compatible = "denver,frameo-rk3126", "rockchip,rk3126", "rockchip,rk3128";

	aliases {
		mmc0 = &emmc;
		mmc1 = &sdmmc;
		mmc2 = &sdio;
		/* U-Boot writes the MAC address derived from the CPU ID here */
		ethernet0 = &wifi;
	};

	chosen {
		stdout-path = "serial2:115200n8";
	};

	/* Overwritten by U-Boot with the size detected by the DDR init */
	memory@60000000 {
		device_type = "memory";
		reg = <0x60000000 0x10000000>;
	};

	adc-keys {
		compatible = "adc-keys";
		io-channels = <&saradc 2>;
		io-channel-names = "buttons";
		keyup-threshold-microvolt = <1800000>;
		poll-interval = <100>;

		button-volume-up {
			label = "Volume Up";
			linux,code = <KEY_VOLUMEUP>;
			press-threshold-microvolt = <10000>;
		};

		button-volume-down {
			label = "Volume Down";
			linux,code = <KEY_VOLUMEDOWN>;
			press-threshold-microvolt = <885000>;
		};
	};

	backlight: backlight {
		compatible = "pwm-backlight";
		pwms = <&pwm0 0 25000 0>;
		brightness-levels = <0 255>;
		num-interpolated-steps = <255>;
		default-brightness-level = <255>;
	};

	gpio-keys {
		compatible = "gpio-keys";

		button-power {
			label = "Power";
			gpios = <&gpio2 RK_PB6 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_POWER>;
			wakeup-source;
		};
	};

	/* Releases the power hold line, the board switches itself off */
	gpio-poweroff {
		compatible = "gpio-poweroff";
		gpios = <&gpio2 RK_PB5 GPIO_ACTIVE_LOW>;
	};

	sdio_pwrseq: sdio-pwrseq {
		compatible = "mmc-pwrseq-simple";
		/* WiFi power enable, high = on */
		reset-gpios = <&gpio1 RK_PB0 GPIO_ACTIVE_LOW>;
	};

	/*
	 * CPU core voltage (board rail "AVDD"), a DC/DC converter controlled
	 * by PWM1. Measured on the board (2026-10-15): linear, 1546 mV at
	 * 0 % duty, 3.106 mV less per percent, 1241 mV at 98.2 %. The stock
	 * U-Boot formula (1450 mV at 0 %, 2.8 mV per percent) is 66 to 96 mV
	 * too low for this board.
	 *
	 * vdd_arm follows the CPU clock (cpufreq, OPP table above), so it is
	 * a continuous regulator, limited to the measured range up to 98.2 %.
	 */
	vdd_arm: regulator-vdd-arm {
		compatible = "pwm-regulator";
		pwms = <&pwm1 0 25000 0>;
		regulator-name = "vdd_arm";
		regulator-min-microvolt = <1241000>;
		regulator-max-microvolt = <1546000>;
		regulator-always-on;
		regulator-boot-on;
		/* The stock U-Boot waits 200 us after changing the PWM */
		regulator-settling-time-us = <500>;
		pwm-dutycycle-unit = <1000>;
		pwm-dutycycle-range = <982 0>;
	};

	/*
	 * Logic core voltage (board rail "CVDD", also GPU and DDR controller),
	 * measured 1.148 V. A fixed DC/DC converter: the RK3126 has no
	 * PWM2 pin (GPIO0_D4 is not bonded out), the PWM2 regulator of the
	 * stock device tree comes from the RK3128 SDK and does nothing here.
	 * Declared as 1.15 V so the 400 MHz GPU OPP (minimum 1.15 V) stays.
	 */
	vdd_logic: regulator-vdd-logic {
		compatible = "regulator-fixed";
		regulator-name = "vdd_logic";
		regulator-min-microvolt = <1150000>;
		regulator-max-microvolt = <1150000>;
		regulator-always-on;
		regulator-boot-on;
	};

	/* SARADC reference, the stock firmware uses 1.8 V */
	vcc_1v8_adc: regulator-vcc-1v8-adc {
		compatible = "regulator-fixed";
		regulator-name = "vcc_1v8_adc";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-always-on;
	};

	/* Panel power switches, both active low in the stock firmware */
	vcc_lcd: regulator-vcc-lcd {
		compatible = "regulator-fixed";
		regulator-name = "vcc_lcd";
		gpio = <&gpio0 RK_PA2 GPIO_ACTIVE_LOW>;
		startup-delay-us = <100000>;
	};

	vcc_lcd_io: regulator-vcc-lcd-io {
		compatible = "regulator-fixed";
		regulator-name = "vcc_lcd_io";
		gpio = <&gpio1 RK_PB1 GPIO_ACTIVE_LOW>;
		startup-delay-us = <100000>;
	};
};

&dphy {
	status = "okay";
};

&dsi {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	panel@0 {
		compatible = "chongzhou,cz101b4001", "jadard,jd9365da-h3";
		reg = <0>;
		backlight = <&backlight>;
		reset-gpios = <&gpio2 RK_PB0 GPIO_ACTIVE_LOW>;
		vdd-supply = <&vcc_lcd>;
		vccio-supply = <&vcc_lcd_io>;

		port {
			panel_in_dsi: endpoint {
				remote-endpoint = <&dsi_out_panel>;
			};
		};
	};
};

&dsi_out {
	dsi_out_panel: endpoint {
		remote-endpoint = <&panel_in_dsi>;
	};
};

&display_subsystem {
	status = "okay";
};

/*
 * No pinctrl: RK3126 and RK3128 route EMMC_CMD to different pins, the
 * Rockchip loader has already set them up.
 */
&emmc {
	bus-width = <8>;
	cap-mmc-highspeed;
	non-removable;
	no-sd;
	no-sdio;
	status = "okay";
};

/*
 * Audio: the internal codec (inno_rk3128, kernel patch 0004) gets its
 * data and MCLK from the 2-channel I2S inside the SoC, its output stage
 * drives two speaker amplifiers (marked 4890, LM4890 class AB, one per
 * speaker), both switched with GPIO2_C0 (stock device tree: spk_ctl_io).
 * DAPM powers the codec first, then the amplifiers.
 *
 * Open problem: playback works, but sounds heavily distorted (strong
 * harmonics on a sine, at any volume). The I2S format, clocks and codec
 * register sequence match the vendor driver; the cause is not found yet,
 * the analog side (amplifier supply and bias) still needs measuring.
 *
 * The RK3126 has no 8-channel I2S and no SPDIF: every access to
 * 0x10200000 and 0x10204000 ends in a bus error. The stock device tree
 * (RK3128 SDK) names i2s_8ch for the codec, but enables the 2-channel
 * I2S without pins, which is the internal connection.
 */
/ {
	acodec: audio-codec@20030000 {
		compatible = "rockchip,rk3128-codec";
		reg = <0x20030000 0x4000>;
		clocks = <&cru PCLK_ACODEC>;
		clock-names = "pclk";
		#sound-dai-cells = <0>;
	};

	speaker_amp: audio-amplifier {
		compatible = "simple-audio-amplifier";
		enable-gpios = <&gpio2 RK_PC0 GPIO_ACTIVE_HIGH>;
		sound-name-prefix = "Speaker Amp";
	};

	sound {
		compatible = "simple-audio-card";
		simple-audio-card,name = "Frame";
		simple-audio-card,format = "i2s";
		simple-audio-card,mclk-fs = <256>;
		simple-audio-card,widgets = "Speaker", "Speaker";
		simple-audio-card,routing =
			"Speaker Amp INL", "HPOUTL",
			"Speaker Amp INR", "HPOUTR",
			"Speaker", "Speaker Amp OUTL",
			"Speaker", "Speaker Amp OUTR";
		simple-audio-card,aux-devs = <&speaker_amp>;

		simple-audio-card,cpu {
			sound-dai = <&i2s_2ch>;
		};

		simple-audio-card,codec {
			sound-dai = <&acodec>;
		};
	};
};

/* Internal connection to the codec, not the external I2S pins */
&i2s_2ch {
	/delete-property/ pinctrl-names;
	/delete-property/ pinctrl-0;
	status = "okay";
};

/*
 * Mali-400 MP2 (lima). vdd_logic is fixed at 1.15 V, so the GPU clock is
 * scaled without voltage changes: drop the 480 MHz point (1.25 V). The
 * stock firmware ran the GPU at 396 MHz.
 *
 * The GPU clock is a divider after a PLL mux: 400 and 200 MHz come from
 * CPLL (800 MHz), 300 MHz would be GPLL/2 (297 MHz). Switching between
 * the two PLLs at run time (devfreq) made the system unstable (dying
 * processes, a white kiosk), so the 300 MHz point is dropped: only the
 * divider changes. 500 MHz fails at 1.15 V (2026-10-16).
 */
&gpu {
	/* Fixed 1.15 V, within the range of all remaining GPU OPPs */
	mali-supply = <&vdd_logic>;
	status = "okay";
};

&gpu_opp_table {
	/delete-node/ opp-300000000;
	/delete-node/ opp-480000000;
};

&i2c0 {
	/*
	 * The stock firmware uses 300 kHz, but then the GSL3673 reads back
	 * wrong data (some 0 bits read as 1) and the firmware load fails.
	 */
	clock-frequency = <100000>;
	status = "okay";

	/*
	 * The touch controller reports 1024x640 with its X axis along the
	 * long side of the panel, running from the bottom (framebuffer
	 * y = 1280) to the top.
	 */
	touchscreen@40 {
		compatible = "silead,gsl3670";
		reg = <0x40>;
		interrupt-parent = <&gpio2>;
		interrupts = <RK_PC3 IRQ_TYPE_EDGE_FALLING>;
		power-gpios = <&gpio2 RK_PC2 GPIO_ACTIVE_HIGH>;
		firmware-name = "gsl3673-denver-frame.fw";
		touchscreen-size-x = <1024>;
		touchscreen-size-y = <640>;
		touchscreen-inverted-x;
		touchscreen-swapped-x-y;
		silead,max-fingers = <10>;
	};
};

/* Enabled for probing only: the stock firmware lists a Goodix touch here */
&i2c2 {
	status = "okay";
};

/*
 * Reading the QoS registers (saved before a power domain is switched off)
 * causes an external abort on the RK3126, and the kernel then hangs on the
 * power domain lock. Skip saving/restoring them; they only hold bus
 * priorities.
 */
&power {
	power-domain@RK3128_PD_VIO {
		/delete-property/ pm_qos;
	};

	power-domain@RK3128_PD_VIDEO {
		/delete-property/ pm_qos;
	};

	power-domain@RK3128_PD_GPU {
		/delete-property/ pm_qos;
	};
};

&pinctrl {
	wifi {
		wifi_host_wake: wifi-host-wake {
			rockchip,pins = <2 RK_PC1 RK_FUNC_GPIO &pcfg_pull_default>;
		};
	};
};

&pwm0 {
	status = "okay";
};

/* vdd_arm */
&pwm1 {
	status = "okay";
};

&saradc {
	vref-supply = <&vcc_1v8_adc>;
	status = "okay";
};

/* RK915 WiFi, out-of-tree driver in drivers/rk915 */
&sdio {
	#address-cells = <1>;
	#size-cells = <0>;
	bus-width = <4>;
	cap-sd-highspeed;
	cap-sdio-irq;
	keep-power-in-suspend;
	max-frequency = <50000000>;
	mmc-pwrseq = <&sdio_pwrseq>;
	no-mmc;
	no-sd;
	non-removable;
	pinctrl-names = "default";
	pinctrl-0 = <&sdio_clk &sdio_cmd &sdio_bus4>;
	status = "okay";

	/* The compatible also enables the SDIO quirks of kernel patch 0005 */
	wifi: wifi@1 {
		compatible = "rockchip,rk915";
		reg = <1>;
		interrupt-parent = <&gpio2>;
		interrupts = <RK_PC1 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "host-wake";
		pinctrl-names = "default";
		pinctrl-0 = <&wifi_host_wake>;
	};
};

&sdmmc {
	bus-width = <1>;
	disable-wp;
	no-mmc;
	no-sdio;
	pinctrl-names = "default";
	pinctrl-0 = <&sdmmc_clk &sdmmc_cmd &sdmmc_det>;
	status = "okay";
};

/*
 * Pull on UART2_RX (GPIO1_C3; fixed pull-up on this pin, the RK3126 can
 * only switch it on or off). The SoC DT leaves it off: without a USB-UART
 * adapter the pin floats, picks up noise and stops the U-Boot autoboot.
 */
&uart2_xfer {
	rockchip,pins = <1 RK_PC2 2 &pcfg_pull_default>,
			<1 RK_PC3 2 &pcfg_pull_default>;
};

&uart2 {
	status = "okay";
};

&usb2phy {
	status = "okay";
};

&usb2phy_host {
	status = "okay";
};

&usb2phy_otg {
	status = "okay";
};

&usb_host_ehci {
	status = "okay";
};

&usb_host_ohci {
	status = "okay";
};

&usb_otg {
	dr_mode = "peripheral";
	status = "okay";
};

/*
 * IOMMU of the VOP, missing in rk3128.dtsi (same layout as on the RK3036:
 * right behind the VOP registers, sharing its interrupt). The stock firmware
 * uses it. Without it the VOP can only scan out physically contiguous
 * buffers and every import of a GPU (lima) buffer fails with "failed to map
 * sg_table to contiguous linear address".
 */
/ {
	vop_mmu: iommu@1010e300 {
		compatible = "rockchip,iommu";
		reg = <0x1010e300 0x100>;
		interrupts = <GIC_SPI 9 IRQ_TYPE_LEVEL_HIGH>;
		clocks = <&cru ACLK_LCDC0>, <&cru HCLK_LCDC0>;
		clock-names = "aclk", "iface";
		power-domains = <&power RK3128_PD_VIO>;
		#iommu-cells = <0>;
	};
};

&vop {
	iommus = <&vop_mmu>;
	status = "okay";
};

/*
 * Hardware video codec (Hantro G1/H1, hantro driver): decodes H.264,
 * MPEG-2 and VP8, encodes JPEG. The separate HEVC decoder of the RK3126
 * has no mainline driver.
 */
&vpu {
	status = "okay";
};

&vpu_mmu {
	status = "okay";
};
