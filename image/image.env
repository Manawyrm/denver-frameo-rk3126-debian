# SD card layout (MiB). The Rockchip BootROM reads idbloader.img at sector
# 64, the miniloader uboot.img at sector 0x4000 (8 MiB); the partitions
# start behind that.
BOOT_START_MB=16
BOOT_SIZE_MB=256
# Root partition in the image; it grows to the size of the card on the
# first boot (growroot.service)
ROOT_SIZE_MB=1536

IDBLOADER_SECTOR=64
UBOOT_SECTOR=16384
