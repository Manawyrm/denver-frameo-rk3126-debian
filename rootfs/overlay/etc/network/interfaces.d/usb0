# USB Ethernet gadget on the OTG port (usb-gadget.service), static address
# on the host network. The default route has a higher metric than the WiFi
# route of dhcpcd (3000 + interface index), so WiFi is preferred.
allow-hotplug usb0
iface usb0 inet static
	address 10.23.99.5/16
	gateway 10.23.0.1
	metric 5000
