# Debian release and mirror for the root file system
DEBIAN_SUITE=trixie
DEBIAN_MIRROR=http://deb.debian.org/debian

# Packages on top of the "minbase" variant. Kernel, RK915 driver and boot
# loader come from output/ (built by the other scripts). whiptail: debconf
# dialogs (without it debconf falls back to plain text, with warnings).
ROOTFS_PACKAGES="
	systemd-sysv udev dbus kmod procps psmisc less
	ifupdown dhcpcd-base iproute2 iputils-ping netbase ca-certificates
	openssh-server systemd-timesyncd
	wpasupplicant iw wireless-regdb rfkill
	htop nano wget curl
	whiptail
	e2fsprogs dosfstools fdisk cloud-guest-utils
"

# Initial root password (SSH login as root is allowed, see
# overlay/etc/ssh/sshd_config.d/frame.conf)
ROOT_PASSWORD=root
