# Applied on top of evb-rk3128_defconfig
CONFIG_DEFAULT_DEVICE_TREE="rockchip/rk3126-generic"
CONFIG_DEFAULT_FDT_FILE="rk3126-generic.dtb"

# Never write an environment anywhere. The stock evb config stores it on
# the eMMC at offset 0, which would destroy the data we want to dump.
# CONFIG_ENV_IS_IN_MMC is not set
CONFIG_ENV_IS_NOWHERE=y
CONFIG_ENV_SOURCE_FILE="rk3126-sdboot"

CONFIG_BOOTDELAY=3
CONFIG_USE_BOOTCOMMAND=y
# SD card first, then the eMMC (see rk3126-sdboot.env)
CONFIG_BOOTCOMMAND="run sdboot; run emmcboot"
CONFIG_SUPPORT_RAW_INITRD=y
CONFIG_CMD_FAT=y
CONFIG_FS_FAT=y
CONFIG_CMD_EXT4=y
CONFIG_CMD_FS_GENERIC=y
CONFIG_CMD_PART=y
CONFIG_CMD_MD5SUM=y
CONFIG_CMD_GPIO=y
CONFIG_SYS_PROMPT="rk3126=> "

# Host tool for UEFI capsule updates (default with EFI_LOADER), not used
# here; it would need the gnutls headers on the build host
# CONFIG_TOOLS_MKEFICAPSULE is not set

# dcache flush/off, needed to chain-load a test U-Boot with loady + go
CONFIG_CMD_CACHE=y

# MAC address from the CPU ID in the eFuse (misc_init_r), passed to the
# kernel as local-mac-address of the ethernet0 alias (the WiFi chip)
CONFIG_MISC=y
CONFIG_MISC_INIT_R=y
CONFIG_ROCKCHIP_EFUSE=y
CONFIG_HASH=y
CONFIG_SHA256=y

# DRAM test that bypasses the caches (patch 0003), to qualify DDR clocks
CONFIG_CMD_DRAMTEST=y
# Change the DDR3 clock from U-Boot (patch 0005)
CONFIG_CMD_RK3128_DDRFREQ=y
