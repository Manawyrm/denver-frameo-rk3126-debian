/*
 * U-Boot default environment for the generic RK3126 SD card image.
 *
 * This file is run through the C preprocessor: do not use '#' comments
 * or apostrophes in here.
 *
 * GPIO1_C2 is either UART2_TX (function 2) or SDMMC_D0 (function 1).
 * GRF_GPIO1C_IOMUX has a write-enable mask in the upper 16 bits, so only
 * the bits for GPIO1_C2 are touched. GPIO1_C3 (UART2_RX) stays on the UART,
 * which is fine because the SD card runs in 1-bit mode.
 */
grf_gpio1c_iomux=0x200080c0
mux_sd=mw.l ${grf_gpio1c_iomux} 0x00300010
mux_uart=mw.l ${grf_gpio1c_iomux} 0x00300020

/*
 * Only the first 768 MiB are lowmem for the kernel. Keep the initramfs and
 * the device tree in the first 256 MiB, otherwise U-Boot moves them to the
 * end of the 1 GiB and the kernel crashes while reading the initramfs.
 */
bootm_size=0x10000000

bootpart=1:1
fdtfile=rk3126-generic.dtb
kernelfile=zImage
initrdfile=initramfs.cpio.gz
/*
 * Kernel messages also on the display (tty0). /dev/console is the last
 * console= entry, so the shell and the init messages stay on the UART.
 */
bootargs_base=console=tty0 console=ttyS2,115200n8 earlycon clk_ignore_unused pd_ignore_unused rdinit=/sbin/init panic=10
bootargs_extra=

/*
 * Root filesystem on a disk partition instead of the initramfs: uEnv.txt
 * sets rootdev (e.g. /dev/mmcblk1p2) and rootfdtfile (a device tree that
 * keeps the SD card pins). "setenv rescue 1; run sdboot" at the prompt
 * starts the initramfs anyway.
 */
rootdev=
rootfdtfile=
rescue=

sdboot=
	echo "Loading Linux from SD card. UART2_TX shares the SDMMC_D0 pin,";
	echo "so expect a few seconds of garbage on the console ...";
	run mux_sd;
	if mmc dev 1 && mmc rescan; then
		if load mmc ${bootpart} ${scriptaddr} uEnv.txt; then
			env import -t -r ${scriptaddr} ${filesize};
		fi;
		if test -n "${rootdev}" && test -z "${rescue}"; then
			if load mmc ${bootpart} ${kernel_addr_r} ${kernelfile} && load mmc ${bootpart} ${fdt_addr_r} ${rootfdtfile}; then
				run mux_uart;
				setenv bootargs ${bootargs_base} root=${rootdev} rootwait rw ${bootargs_extra};
				echo;
				echo "Booting ${kernelfile} with ${rootfdtfile}, root ${rootdev}";
				echo "bootargs: ${bootargs}";
				echo "The UART goes silent when Linux takes over the SD card.";
				bootz ${kernel_addr_r} - ${fdt_addr_r};
			fi;
		elif load mmc ${bootpart} ${kernel_addr_r} ${kernelfile} && load mmc ${bootpart} ${fdt_addr_r} ${fdtfile} && load mmc ${bootpart} ${ramdisk_addr_r} ${initrdfile}; then
			setenv initrd_size ${filesize};
			run mux_uart;
			setenv bootargs ${bootargs_base} ${bootargs_extra};
			echo;
			echo "Booting ${kernelfile} with ${fdtfile}";
			echo "bootargs: ${bootargs}";
			bootz ${kernel_addr_r} ${ramdisk_addr_r}:${initrd_size} ${fdt_addr_r};
		fi;
	fi;
	run mux_uart;
	echo;
	echo "SD boot failed. Use run sdboot to retry.";
