# Pinned U-Boot release: git tag and the commit it has to point to (2026.10
# is not published as a tarball)
UBOOT_VERSION=2026.10
UBOOT_GIT=https://source.denx.de/u-boot/u-boot.git
UBOOT_TAG=v2026.10
UBOOT_COMMIT=5508406582f6f7120dce0c4b3059819a41788db2

# DDR init + miniloader (idbloader.img, sector 64) from the stock firmware:
# DDR init 2.08 and miniloader 2.59, taken unchanged from sector 64 of the
# frame's eMMC. There is no mainline DDR init for the RK3126, and the rkbin
# miniloader (2.63) only starts U-Boot through a trust OS (OP-TEE): without
# trust.img it drops into USB download mode, which does not work on this
# board. The stock miniloader starts U-Boot without one.
IDBLOADER_BLOB=blobs/idbloader-stock-2.59.img
IDBLOADER_SHA256=1623be9a9154121ba78a9aeaefcda873a84cfe50737815f3bb3d1aa6fb2d66b4

# loaderimage tool from a pinned rkbin commit
RKBIN_COMMIT=3e288fe814e059dd06833495f845cab04ac20a5c
RKBIN_URL=https://raw.githubusercontent.com/rockchip-linux/rkbin/${RKBIN_COMMIT}
RKBIN_LOADERIMAGE=tools/loaderimage
RKBIN_LOADERIMAGE_SHA256=e26a311d449c6254d0d89ecaf8cd1870438205e07a66b27265d68830b8977439

# Debian package version ${UBOOT_VERSION}-${UBOOT_PKG_REVISION}, raise the
# revision whenever patches, device tree, config or environment change
UBOOT_PKG_REVISION=1
